{
  "sequenceDiagram": {
    "title": "Factory to Customer Device Lifecycle",
    "participants": [
      {
        "id": "factory",
        "name": "Factory"
      },
      {
        "id": "dongle",
        "name": "Dongle"
      },
      {
        "id": "cvip",
        "name": "CVIP Cloud"
      }
    ],
    "states": [
      "Factory",
      "Provisioned",
      "Authorized",
      "Customer"
    ],
    "interactions": [
      {
        "step": 1,
        "from": "factory",
        "to": "dongle",
        "message": "Manufacturing completed & dongle inserted",
        "state": "Factory"
      },
      {
        "step": 2,
        "from": "dongle",
        "to": "cvip",
        "message": "MQTT connection using common certificate"
      },
      {
        "step": 3,
        "from": "cvip",
        "to": "dongle",
        "message": "Subscribe to CSR access token"
      },
      {
        "step": 4,
        "from": "cvip",
        "to": "dongle",
        "message": "Provide access token"
      },
      {
        "step": 5,
        "from": "dongle",
        "to": "cvip",
        "message": "Publish IMEI to CSR access token"
      },
      {
        "step": 6,
        "from": "dongle",
        "to": "cvip",
        "message": "Request device certificate creation",
        "data": [
          "Access Token",
          "CVIP Bundle"
        ]
      },
      {
        "step": 7,
        "from": "cvip",
        "to": "dongle",
        "message": "Return device certificate"
      },
      {
        "step": 8,
        "from": "dongle",
        "to": "cvip",
        "message": "Device join accepted",
        "state": "Provisioned"
      },
      {
        "step": 9,
        "from": "cvip",
        "to": "dongle",
        "message": "Command to change state to Authorized"
      },
      {
        "step": 10,
        "from": "dongle",
        "to": "cvip",
        "message": "Reconnect using device certificate"
      },
      {
        "step": 11,
        "from": "dongle",
        "to": "cvip",
        "message": "Authorization acknowledged",
        "state": "Authorized"
      },
      {
        "step": 12,
        "from": "cvip",
        "to": "dongle",
        "message": "Initiate customer ownership transfer"
      },
      {
        "step": 13,
        "from": "dongle",
        "to": "cvip",
        "message": "Customer activation confirmed",
        "state": "Customer"
      }
    ]
  }
}